# Copy to .env and fill in. See docs/specs/homewatch-spec.md §6.
HOMEWATCH_DB=data/homewatch.sqlite
# Optional bearer token; if set, all routes except GET /til/drop/... require it.
HOMEWATCH_TOKEN=
# Home Assistant instance + long-lived access token (from HA /profile).
HOMEWATCH_HA_URL=http://hass.local:8123
HOMEWATCH_HA_TOKEN=
# HomePod discovery backend: pyatv | zeroconf | disabled
HOMEWATCH_HOMEPOD_DISCOVERY=disabled
HOMEWATCH_BIND=127.0.0.1:8765
# Set a real UA with a contact URL — Apple/GitHub rate-limit anonymous crawlers.
HOMEWATCH_USER_AGENT=homewatch/0.1 (+https://github.com/mcint/homewatch)
